#!/usr/bin/env bash
# OPOS Shell Wayland session: runs the Electron shell fullscreen inside the `cage` kiosk compositor.
# Installed to /usr/local/bin/opos-session by scripts/install-greeter.sh --with-session.
set -euo pipefail

OPOS_DIR="${OPOS_DIR:-/opt/opos-shell}"
LOG="${XDG_STATE_HOME:-$HOME/.local/state}/opos/session.log"
mkdir -p "$(dirname "$LOG")"
exec >>"$LOG" 2>&1
echo "=== OPOS session $(date -Is) ==="

# Resolve the shell binary: an electron-builder unpacked build, an AppImage, or a source checkout.
if [[ -x "$OPOS_DIR/opos-shell" ]]; then
  APP=("$OPOS_DIR/opos-shell")
elif compgen -G "$OPOS_DIR/*.AppImage" >/dev/null; then
  APP=("$(ls -1 "$OPOS_DIR"/*.AppImage | head -n1)")
elif [[ -x "$OPOS_DIR/node_modules/.bin/electron" && -f "$OPOS_DIR/dist/index.html" ]]; then
  APP=("$OPOS_DIR/node_modules/.bin/electron" "$OPOS_DIR")
else
  echo "OPOS Shell not found in $OPOS_DIR (set OPOS_DIR or run 'npm run build' there)." >&2
  exit 1
fi

command -v cage >/dev/null 2>&1 || { echo "cage is not installed: sudo dnf install cage" >&2; exit 1; }

export XDG_CURRENT_DESKTOP=OPOS
export XDG_SESSION_DESKTOP=OPOS
export ELECTRON_OZONE_PLATFORM_HINT=wayland

# -d: no client-side decorations, -s: allow VT switching
exec cage -d -s -- "${APP[@]}" --ozone-platform=wayland --enable-features=WaylandWindowDecorations
